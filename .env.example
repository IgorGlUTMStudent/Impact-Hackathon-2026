# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# DJANGO_SETTINGS_MODULE cannot be set here (.env is read after settings are chosen):
#   manage.py defaults to config.settings.dev; config/wsgi.py (gunicorn) defaults to config.settings.prod.
#   On the host set DJANGO_SETTINGS_MODULE=config.settings.prod plus the variables below in its environment.

# Required in prod; dev falls back to an insecure local-only key.
DJANGO_SECRET_KEY=change-me
# Comma-separated, prod only.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated https origins, prod only (e.g. https://example.onrender.com).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Empty = local SQLite file db.sqlite3. Postgres host: postgres://USER:PASSWORD@HOST:5432/NAME
DATABASE_URL=

# Synthetic demo accounts created by `manage.py seed_demo`. Empty = accounts get unusable passwords / no PIN.
DEMO_PASSWORD=
DEMO_PIN=
